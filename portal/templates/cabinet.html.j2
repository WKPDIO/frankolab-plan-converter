<!doctype html>
<html lang="uk">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#ffffff">
<title>Мій план лікування · FrankoLab</title>
<style>
@font-face { font-family: "Onest"; src: url(data:font/woff2;base64,{{ font_b64 }}) format("woff2"); font-weight: 100 900; font-display: swap; }
:root {
  --ink: #212121; --graphite: #474a50; --ice: #eaeff5; --storm: #99aabe; --storm-deep: #6f839c;
  --sand: #d8c3a5; --linen: #f0e7de; --sky: #9ac2f4; --white: #ffffff; --line: rgba(33,33,33,.1);
  --r: 14px; color-scheme: light;
}
* { box-sizing: border-box; }
html { -webkit-text-size-adjust: 100%; }
body { margin: 0; background: #f6f7f9; color: var(--ink); font: 400 15px/1.5 "Onest", system-ui, sans-serif; }
a { color: inherit; }
.wrap { max-width: 560px; margin: 0 auto; padding: 0 16px 40px; }
.top { position: sticky; top: 0; z-index: 5; background: rgba(246,247,249,.92); backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px); border-bottom: 1px solid var(--line); }
.top .wrap { display: flex; align-items: center; justify-content: space-between; height: 54px; padding-bottom: 0; }
.wm { font-size: 19px; font-weight: 400; letter-spacing: -.01em; line-height: 1; }
.wm small { display: block; font-size: 8.5px; letter-spacing: .02em; color: var(--graphite); margin-top: 3px; }
.pill { font-size: 11px; padding: 3px 9px; border-radius: 99px; background: var(--linen); color: var(--graphite); }

.hello { padding: 22px 2px 6px; }
.eyebrow { font-size: 12px; color: var(--graphite); margin: 0; }
h1 { font-size: 27px; font-weight: 600; letter-spacing: -.015em; margin: 2px 0 4px; line-height: 1.15; }
.meta { font-size: 13px; color: var(--graphite); margin: 0; }

.card { background: var(--white); border-radius: var(--r); padding: 18px; margin-top: 14px; box-shadow: 0 1px 0 rgba(33,33,33,.04); }
.label { font-size: 12px; color: var(--graphite); }
.prog-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 12px; }
.prog-head .big { font-size: 22px; font-weight: 600; letter-spacing: -.01em; line-height: 1.2; }
.pct { font-size: 28px; font-weight: 300; color: var(--storm-deep); line-height: 1; }
.bar { height: 8px; border-radius: 99px; background: var(--ice); margin: 14px 0 8px; overflow: hidden; }
.bar i { display: block; height: 100%; border-radius: 99px; background: var(--storm); }
.small { font-size: 13px; color: var(--graphite); margin: 0; }
.next { margin-top: 14px; padding: 12px 14px; border-radius: 10px; background: var(--ice); }
.next b { display: block; font-weight: 500; font-size: 15px; margin-top: 2px; }
.next span.t { font-size: 13px; color: var(--graphite); }

.money-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 10px; }
.m { padding: 12px; border-radius: 10px; background: var(--ice); }
.m.debt { background: var(--linen); }
.m.wide { grid-column: 1 / -1; background: none; border: 1px solid var(--line); }
.m .v { font-size: 17px; font-weight: 600; margin-top: 2px; line-height: 1.25; }
.m.wide .v { font-weight: 500; }
details.sub { border-top: 1px solid var(--line); margin-top: 14px; }
details.sub:first-of-type { margin-top: 16px; }
details.sub > summary { list-style: none; cursor: pointer; padding: 12px 0 2px; display: flex; justify-content: space-between; font-size: 14px; font-weight: 500; }
details.sub > summary::-webkit-details-marker, details.stage > summary::-webkit-details-marker,
details.proc > summary::-webkit-details-marker, details.memo > summary::-webkit-details-marker { display: none; }
details.sub > summary::after { content: "+"; color: var(--storm-deep); font-weight: 300; font-size: 18px; line-height: 1; }
details.sub[open] > summary::after { content: "–"; }
.list { list-style: none; margin: 8px 0 0; padding: 0; }
.list li { display: flex; justify-content: space-between; gap: 12px; padding: 7px 0; border-bottom: 1px dashed var(--line); font-size: 14px; }
.list li:last-child { border-bottom: none; }
.act-date { font-size: 12px; color: var(--graphite); margin: 10px 0 2px; }
.act li { display: block; }
.act li small { display: block; color: var(--graphite); font-size: 12px; }
.note { font-size: 12px; color: var(--graphite); margin: 12px 0 0; }

h2.sec { font-size: 18px; font-weight: 600; margin: 30px 2px 4px; letter-spacing: -.01em; }

details.stage { background: var(--white); border-radius: var(--r); margin-top: 12px; overflow: hidden; }
details.stage > summary { list-style: none; cursor: pointer; display: grid; grid-template-columns: auto 1fr auto; gap: 12px; align-items: center; padding: 16px 18px; }
.snum { font-size: 34px; font-weight: 200; color: var(--storm); line-height: 1; letter-spacing: -.02em; }
.stitle { font-size: 16px; font-weight: 600; line-height: 1.25; }
.smeta { font-size: 12px; color: var(--graphite); margin-top: 3px; }
.chip { display: inline-block; font-size: 11px; font-weight: 500; padding: 2px 8px; border-radius: 99px; margin-left: 6px; vertical-align: 2px; }
.chip.done { background: var(--storm); color: var(--white); }
.chip.current { background: var(--sky); color: var(--ink); }
.chip.planned { border: 1px solid var(--storm); color: var(--graphite); }
.chev { width: 22px; height: 22px; transition: transform .2s; color: var(--storm-deep); }
details[open] > summary .chev { transform: rotate(180deg); }
.sbody { padding: 0 18px 18px; }
.sprog { font-size: 13px; color: var(--graphite); margin: -4px 0 12px; }
.map { background: #fbfcfd; border: 1px solid var(--line); border-radius: 12px; padding: 10px 8px 6px; }
.map svg.chart { width: 100%; height: auto; display: block; }
.ch-line { stroke: var(--storm); stroke-width: .75; }
.ch-num { font: 400 8px "Onest"; fill: #8d9bb0; }
.ch-num-on { font: 700 8.6px "Onest"; fill: var(--ink); }
.map-cap { display: flex; justify-content: space-between; font-size: 10px; color: var(--graphite); margin-top: 2px; padding: 0 2px; }
.legend { display: grid; grid-template-columns: 1fr 1fr; gap: 6px 12px; margin-top: 12px; }
.lg { display: flex; align-items: center; gap: 6px; }
.lg svg { flex: 0 0 auto; }
.lg-name { font-size: 12px; line-height: 1.2; }
.lg-teeth { font-size: 11px; color: var(--graphite); }
.other { font-size: 12px; color: var(--graphite); margin: 10px 0 0; }

.blk { margin-top: 16px; border-radius: 12px; background: var(--tint); padding: 12px; }
.blk-h { display: flex; flex-direction: column; padding: 2px 4px 8px; }
.blk-h b { font-size: 14px; font-weight: 600; line-height: 1.3; }
.blk-h span { font-size: 12px; color: var(--graphite); }
details.proc { background: var(--white); border-radius: 10px; margin-top: 6px; }
details.proc > summary { list-style: none; cursor: pointer; display: grid; grid-template-columns: 46px 1fr 24px; gap: 10px; align-items: center; padding: 8px 10px 8px 8px; }
.th { width: 46px; height: 46px; border-radius: 8px; overflow: hidden; background: #f4f6f9; line-height: 0; }
.th svg { width: 46px; height: 46px; }
.pn b { display: block; font-size: 14px; font-weight: 500; line-height: 1.3; }
.pn small { display: block; font-size: 12px; color: var(--graphite); margin-top: 1px; }
.st { width: 22px; height: 22px; }
.pbody { padding: 2px 14px 14px; }
.bigpic { width: 100%; max-width: 280px; aspect-ratio: 1; margin: 0 auto 6px; background: var(--ice); border-radius: 12px; line-height: 0; }
.pbody p { margin: 8px 0 0; font-size: 14px; line-height: 1.55; }
.incl { font-size: 13px !important; color: var(--graphite); }
.incl b { font-weight: 500; color: var(--ink); }
.price { display: flex; justify-content: space-between; align-items: baseline; margin-top: 12px; padding-top: 10px; border-top: 1px solid var(--line); font-size: 13px; color: var(--graphite); }
.price b { font-size: 15px; color: var(--ink); font-weight: 600; }
.lab { display: inline-block; margin-top: 10px; font-size: 11px; padding: 2px 8px; border-radius: 6px; background: var(--sand); color: var(--ink); font-weight: 500; }
.state-line { font-size: 12px; margin-top: 10px; color: var(--storm-deep); font-weight: 500; }
details.memo { margin-top: 8px; background: var(--white); border: 1px solid var(--sand); border-radius: 10px; }
details.memo > summary { list-style: none; cursor: pointer; padding: 10px 12px; font-size: 13px; font-weight: 500; display: flex; justify-content: space-between; gap: 10px; }
details.memo > summary small { display: block; font-weight: 400; font-size: 11px; color: var(--graphite); }
details.memo > summary::after { content: "+"; color: var(--sand); font-size: 18px; line-height: 1; font-weight: 300; }
details.memo[open] > summary::after { content: "–"; }
details.memo ul { margin: 0; padding: 0 14px 12px 30px; font-size: 13.5px; line-height: 1.5; }
details.memo li + li { margin-top: 5px; }
.stotal { display: flex; justify-content: space-between; margin-top: 16px; padding-top: 12px; border-top: 1px solid var(--line); font-size: 14px; }
.stotal b { font-weight: 600; }

.contact p { margin: 4px 0 0; font-size: 14px; }
.btn { display: block; text-align: center; margin-top: 14px; padding: 13px; border-radius: 12px; background: var(--ink); color: var(--white); text-decoration: none; font-weight: 500; }
.btn.ghost { background: none; color: var(--ink); border: 1px solid var(--line); margin-top: 8px; }
.demo-note { font-size: 12px; color: var(--graphite); text-align: center; margin: 18px 8px 0; }
</style>
</head>
<body>
{% macro state_icon(s) -%}
{%- if s == 'done' -%}<svg class="st" viewBox="0 0 22 22" aria-label="виконано"><circle cx="11" cy="11" r="10" fill="#99aabe"/><path d="M6.5 11.3l3 3 6-6.4" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
{%- elif s == 'partial' -%}<svg class="st" viewBox="0 0 22 22" aria-label="частково виконано"><circle cx="11" cy="11" r="9.3" fill="none" stroke="#99aabe" stroke-width="1.4"/><path d="M11 1.7a9.3 9.3 0 0 1 0 18.6Z" fill="#99aabe"/></svg>
{%- else -%}<svg class="st" viewBox="0 0 22 22" aria-label="заплановано"><circle cx="11" cy="11" r="9.3" fill="none" stroke="#c3ccd7" stroke-width="1.4"/></svg>
{%- endif -%}
{%- endmacro %}
{% set chev %}<svg class="chev" viewBox="0 0 22 22"><path d="M6 8.5l5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>{% endset %}

<header class="top"><div class="wrap">
  <div class="wm">FrankoLab<small>Clinic &amp; Tech Lab</small></div>
  {% if demo %}<span class="pill">демо</span>{% endif %}
</div></header>

<main class="wrap">
  <section class="hello">
    <p class="eyebrow">Ваш план лікування</p>
    <h1>Вітаємо, {{ hello }}</h1>
    <p class="meta">Лікар {{ h.doctor }} · план від {{ h.date }}</p>
  </section>

  <section class="card">
    <div class="prog-head">
      <div>
        <div class="label">{% if current %}Зараз{% else %}Лікування{% endif %}</div>
        <div class="big">{% if current %}Етап {{ current|int }} з {{ n_stages }}{% else %}Завершено{% endif %}</div>
      </div>
      <div class="pct">{{ pct }}%</div>
    </div>
    <div class="bar"><i style="width: {{ pct }}%"></i></div>
    <p class="small">Виконано {{ n_done }} з {{ n_all }} процедур</p>
    {% if next_step %}<div class="next"><span class="label">Наступний крок</span><b>{{ next_step.name }}</b>{% if next_step.teeth %}<span class="t">Зуби: {{ next_step.teeth }}</span>{% endif %}</div>{% endif %}
  </section>

  <section class="card">
    <div class="label">Оплата</div>
    <div class="money-grid">
      <div class="m"><div class="label">Сплачено</div><div class="v">{{ paid }}</div></div>
      <div class="m {{ 'debt' if debt }}"><div class="label">До сплати за виконане</div><div class="v">{{ debt or '0 грн' }}</div></div>
      <div class="m wide"><div class="label">Залишок за всім планом</div><div class="v">{{ left or '0 грн' }}</div><div class="label" style="margin-top:4px">Вартість плану: {{ total }}</div></div>
    </div>
    {% if payments %}
    <details class="sub"><summary>Історія оплат</summary>
      <ul class="list">{% for p in payments %}<li><span>{{ p.date }}</span><b>{{ p.amount }}</b></li>{% endfor %}</ul>
    </details>
    {% endif %}
    {% if acts %}
    <details class="sub"><summary>Виконані роботи</summary>
      {% for a in acts %}<div class="act-date">{{ a.date }}</div>
      <ul class="list act">{% for it in a["items"] %}<li>{{ it.name }}{% if it.teeth %}<small>Зуби: {{ it.teeth }}</small>{% endif %}</li>{% endfor %}</ul>{% endfor %}
    </details>
    {% endif %}
    <p class="note">{% if has_eur %}Суми в євро сплачуються в гривнях за комерційним курсом на день оплати. {% endif %}{{ included_note }}</p>
  </section>

  <h2 class="sec">Етапи лікування</h2>
  {% for ph in phases %}
  <details class="stage"{% if ph.state == 'current' or (not current and loop.first) %} open{% endif %}>
    <summary>
      <span class="snum">{{ ph.num }}</span>
      <span>
        <span class="stitle">{{ ph.title }}</span><span class="chip {{ ph.state }}">{{ {'done': 'завершено', 'current': 'зараз', 'planned': 'попереду'}[ph.state] }}</span>
        <div class="smeta">{% if ph.timing %}{{ ph.timing }} · {% endif %}{{ ph.duration }}</div>
      </span>
      {{ chev }}
    </summary>
    <div class="sbody">
      <p class="sprog">Виконано {{ ph.n_done }} з {{ ph.n_all }} процедур</p>
      {% if ph.map %}
      <div class="map">{{ ph.map }}<div class="map-cap"><span>права сторона</span><span>ліва сторона</span></div></div>
      <div class="legend">{% for e in ph.legend %}<div class="lg">{{ e.glyph }}<div><div class="lg-name">{{ e.label }}</div>{% if e.teeth %}<div class="lg-teeth">{{ e.teeth }}</div>{% endif %}</div></div>{% endfor %}</div>
      {% endif %}
      {% if ph.other %}<p class="other">Також на цьому етапі: {{ ph.other|join(', ') }}.</p>{% endif %}

      {% for b in ph.blocks %}
      <div class="blk" style="--tint: {{ b.tint }}">
        <div class="blk-h"><b>{{ b.title }}</b>{% if b.plain %}<span>{{ b.plain }}</span>{% endif %}</div>
        {% for r in b.rows %}
        <details class="proc {{ r.state }}">
          <summary>
            <span class="th">{{ r.thumb or '' }}</span>
            <span class="pn"><b>{{ r.name }}</b>{% if r.teeth %}<small>Зуби: {{ r.teeth|join(', ') }}</small>{% elif r.qty > 1 %}<small>{{ r.qty }} рази</small>{% endif %}</span>
            {{ state_icon(r.state) }}
          </summary>
          <div class="pbody">
            {% if r.big %}<div class="bigpic">{{ r.big }}</div>{% endif %}
            {% if r.desc_full %}<p>{{ r.desc_full }}</p>{% endif %}
            {% if r.incl %}<p class="incl"><b>У ціні:</b> {{ r.incl }}</p>{% endif %}
            {% if r.lab %}<span class="lab">Виготовляє наша лабораторія</span>{% endif %}
            <div class="state-line">{% if r.state == 'done' %}Виконано{% elif r.state == 'partial' %}Виконано {{ r.done_qty }} з {{ r.qty }}{% else %}Заплановано{% endif %}</div>
            <div class="price"><span>{{ r.unit }}{% if r.disc %} ({{ r.disc }}){% endif %}{% if r.qty > 1 %} × {{ r.qty }}{% endif %}</span><b>{{ r.line_total }}</b></div>
          </div>
        </details>
        {% endfor %}
        {% for m in b.memos %}
        <details class="memo"><summary><span><small>Пам'ятка · {{ 'перед процедурою' if m.kind == 'before' else 'після процедури' }}</small>{{ m.title }}</span></summary>
          <ul>{% for it in m["items"] %}<li>{{ it }}</li>{% endfor %}</ul>
        </details>
        {% endfor %}
      </div>
      {% endfor %}
      <div class="stotal"><span>Вартість етапу</span><b>{{ ph.total }}</b></div>
    </div>
  </details>
  {% endfor %}

  <section class="card contact">
    <div class="label">Є питання щодо плану?</div>
    <p>Зателефонуйте — пояснимо кожен крок.</p>
    <a class="btn" href="{{ phone_href }}">Зателефонувати {{ h.phone_fmt }}</a>
    {% if h.website %}<a class="btn ghost" href="{{ h.website }}">{{ site_short }}</a>{% endif %}
    <p class="note">{{ h.address }}</p>
  </section>
  {% if demo %}<p class="demo-note">Прогрес і оплати на цій сторінці — приклад. Після підключення ClinicCards тут будуть справжні дані з клініки.</p>{% endif %}
</main>
</body>
</html>
